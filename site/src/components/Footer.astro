---
import FutureLink from "./FutureLink.astro";
import Icon from "./Icon.astro";
import { phones, email, socials } from "../data/content";
const anchors = [
  { href: "#napryamy", label: "Напрями" },
  { href: "#statti", label: "Нові матеріали" },
  { href: "#proektuvalnykam", label: "Проєктувальникам" },
  { href: "#kontakty", label: "Контакти" },
];
const rubrics = ["Фасади", "Стелі", "Паркани", "Метал", "Сад і город", "Новини", "Корисне"];
const products = ["Продукція: фасади", "Продукція: стелі", "Продукція: паркани", "Продукція: профілі"];
---
<footer class="ft">
  <div class="ft__bar on-dark">
    <div class="container ft__bar-in">
      <a class="ft__logo" href="#top" aria-label="Мехбуд, на початок сторінки"><img src="/img/logo-mehbud.png" width="105" height="59" alt="Мехбуд" /></a>
      <p class="ft__slogan">Ми робимо країну красивою!</p>
      <div class="ft__contacts">
        <a href={phones.kyiv.href}>{phones.kyiv.label}</a>
        <a href={email.href}>{email.label}</a>
      </div>
    </div>
  </div>
  <div class="container ft__cols">
    <nav class="ft__col" aria-label="Розділи головної">
      <p class="ft__h">Розділи</p>
      <ul>{anchors.map((a) => <li><a class="ft__a" href={a.href}>{a.label}</a></li>)}</ul>
    </nav>
    <div class="ft__col ft__col--fl">
      <p class="ft__h">Рубрики і продукція</p>
      <ul class="ft__fl">{[...rubrics, ...products].map((r) => <li><FutureLink>{r}</FutureLink></li>)}</ul>
    </div>
    <div class="ft__col">
      <p class="ft__h">Соцмережі</p>
      <ul class="ft__social">
        {socials.map((s) => (
          <li><a class="ft__a ft__soc" href={s.href} target="_blank" rel="noopener noreferrer"><Icon name={s.icon} />{s.name}</a></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="container ft__legal">
    <p>© Завод «Мехбуд»</p>
    <FutureLink>Політика конфіденційності</FutureLink>
  </div>
</footer>

<style>
  .ft { margin-top: var(--seam); }
  .ft__bar { background: var(--color-primary); color: var(--color-on-primary); }
  .ft__bar-in { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-5); padding-block: var(--space-5); }
  .ft__logo { display: block; background: var(--color-on-primary); border-radius: 50%; padding: var(--space-1) var(--space-3); }
  .ft__logo img { height: 48px; width: auto; }
  .ft__slogan { font-weight: 400; color: var(--color-primary-muted); }
  .ft__contacts { display: flex; flex-wrap: wrap; gap: 0 var(--space-5); margin-left: auto; }
  .ft__contacts a { display: inline-flex; align-items: center; min-height: var(--tap); font-family: var(--font-display); font-weight: 800; font-size: var(--fs-21); text-decoration: none; }
  .ft__contacts a:hover { text-decoration: underline; }
  .ft__cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5) var(--space-4); padding-block: var(--space-6) var(--space-5); }
  .ft__h { font-family: var(--font-body); font-size: var(--fs-14); font-weight: 400; color: var(--color-text-muted); margin-bottom: var(--space-2); }
  .ft__col ul { display: grid; }
  .ft__col--fl { grid-column: 1 / -1; }
  .ft__fl { display: flex !important; flex-wrap: wrap; gap: 0 var(--space-4); }
  .ft__a { display: inline-flex; align-items: center; gap: var(--space-2); min-height: var(--tap); text-decoration: none; font-weight: 600; }
  .ft__a:hover { text-decoration: underline; }
  .ft__legal { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-3); padding-block: var(--space-4) var(--space-5); border-top: 1px solid var(--color-metal); font-size: var(--fs-14); color: var(--color-text-muted); }
  @media (max-width: 767px) { .ft__contacts { margin-left: 0; } }
  @media (min-width: 1024px) { .ft__cols { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr) minmax(0, 1fr); } .ft__col--fl { grid-column: auto; } }
</style>
