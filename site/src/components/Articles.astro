---
import FutureLink from "./FutureLink.astro";
import Cover from "./Cover.astro";
import { articles, rubricNames, type Rubric } from "../data/content";
const chips: { id: "all" | Rubric; label: string }[] = [
  { id: "all", label: "Усі" },
  { id: "fasadi", label: "Фасади" },
  { id: "steli", label: "Стелі" },
  { id: "parkany", label: "Паркани" },
  { id: "metal", label: "Метал" },
  { id: "sad", label: "Сад і город" },
];
---
<section id="statti" class="statti section-pad section-pad--tight-end" data-rec="UX-R005" aria-labelledby="statti-h">
  <div class="container">
    <div class="statti__head">
      <h2 id="statti-h" class="h2">Нові матеріали</h2>
      <div class="chips" role="group" aria-label="Фільтр матеріалів за напрямом">
        {chips.map((c, i) => <button type="button" class="chip" data-filter={c.id} aria-pressed={i === 0 ? "true" : "false"}>{c.label}</button>)}
      </div>
    </div>

    <ul class="grid" data-filter="all" aria-live="polite">
      {articles.map((a, i) => (
        <li class:list={["card", i === 0 && "card--lead", i > 0 && i < 4 && "card--side", i >= 4 && "card--wide"]} data-rubric={a.rubric}>
          <div class="card__media">
            <Cover
              img={a.img}
              alt={a.title}
              ratio={i === 0 ? "16 / 9" : "3 / 2"}
              sizes={i === 0 ? "(min-width: 1024px) 56vw, 100vw" : "(min-width: 1024px) 26vw, (min-width: 768px) 45vw, 34vw"}
            />
          </div>
          <div class="card__body">
            <h3 class="card__title"><FutureLink class="card__link">{a.title}</FutureLink></h3>
            <p class="card__tag"><span class:list={["card__bar", `card__bar--${a.rubric}`]} aria-hidden="true"></span>{rubricNames[a.rubric]}</p>
            {a.lead && <p class="card__lead">{a.lead}</p>}
          </div>
        </li>
      ))}
    </ul>

    <p class="statti__all"><FutureLink>Усі статті</FutureLink></p>
  </div>
</section>

<script>
  // Effect 4: filter the six cards already on the page (opacity only, no layout animation).
  const grid = document.querySelector<HTMLElement>("#statti .grid");
  const chips = document.querySelectorAll<HTMLButtonElement>("#statti .chip");
  const cards = grid ? Array.from(grid.querySelectorAll<HTMLElement>(".card")) : [];
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let timer = 0;
  chips.forEach((chip) =>
    chip.addEventListener("click", () => {
      if (!grid) return;
      const f = chip.dataset.filter ?? "all";
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
      const show = (el: HTMLElement) => f === "all" || el.dataset.rubric === f;
      const apply = () => {
        grid.dataset.filter = f;
        cards.forEach((el) => {
          el.hidden = !show(el);
          el.classList.remove("is-out");
          if (!el.hidden && !reduce) {
            el.classList.add("is-in");
            requestAnimationFrame(() => requestAnimationFrame(() => el.classList.remove("is-in")));
          }
        });
      };
      window.clearTimeout(timer);
      if (reduce) return apply();
      cards.forEach((el) => { if (!el.hidden && !show(el)) el.classList.add("is-out"); });
      timer = window.setTimeout(apply, 160);
    })
  );
</script>

<style>
  .statti__head { display: grid; gap: var(--space-4); margin-bottom: var(--space-5); }
  .chips { display: none; flex-wrap: wrap; gap: var(--space-2); }
  :global(.js) .chips { display: flex; }
  .chip { min-height: var(--tap); padding: 0 var(--space-3); border: 2px solid var(--color-text); border-radius: var(--radius); background: transparent; color: var(--color-text); font-weight: 600; font-size: var(--fs-17); cursor: pointer; transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out); }
  .chip:hover { background: var(--color-surface); }
  .chip[aria-pressed="true"] { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-accent-ink); }

  .grid { display: grid; gap: var(--space-5) var(--space-4); }
  .card { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: var(--space-3); align-items: start; transition: opacity var(--dur-fast) var(--ease-out); }
  .card[hidden] { display: none; }
  .card.is-out { opacity: 0; transition-duration: 160ms; }
  .card.is-in { opacity: 0; transition: none; }
  .card--lead { grid-template-columns: minmax(0, 1fr); }
  .card__media { overflow: hidden; }
  .card__media :global(img) { transition: transform var(--dur) var(--ease-out); }
  @media (hover: hover) { .card:hover .card__media :global(img) { transform: scale(1.03); } }
  .card__body { display: grid; gap: var(--space-2); align-content: start; }
  .card__tag { display: flex; align-items: center; gap: var(--space-2); font-size: var(--fs-14); font-weight: 400; color: var(--color-text-muted); }
  .card__bar { width: 24px; height: 6px; flex: none; }
  .card__bar--fasadi { background: var(--color-primary); }
  .card__bar--steli { background: var(--color-dark-2); }
  .card__bar--parkany { background: var(--color-metal); }
  .card__bar--metal { background: var(--color-text); }
  .card__bar--sad { background: var(--color-text-muted); }
  .card__title { font-family: var(--font-body); font-weight: 600; font-size: var(--fs-17); line-height: 1.3; }
  .card :global(.card__link) { display: inline; min-height: 0; text-decoration: none; }
  .card :global(.card__link):hover { text-decoration: underline; }
  .card--lead .card__title { font-family: var(--font-display); font-weight: 800; font-size: var(--fs-card); line-height: 1.15; letter-spacing: -0.01em; }
  .card__lead { color: var(--color-text-muted); max-width: 60ch; }
  .statti__all { margin-top: var(--space-5); font-weight: 600; }

  @media (min-width: 768px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .card { grid-template-columns: minmax(0, 1fr); }
    .card--lead { grid-column: 1 / -1; }
    .card__title { font-size: var(--fs-21); }
  }
  @media (min-width: 1024px) {
    .statti__head { grid-template-columns: auto minmax(0, 1fr); align-items: end; gap: var(--space-5); }
    .chips { justify-content: flex-end; }
    .grid { grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--space-5) var(--space-4); }
    .card { grid-column: span 4; }
    .card--lead { grid-column: 1 / span 7; grid-row: span 3; }
    .card--side { grid-column: 8 / span 5; grid-template-columns: var(--thumb) minmax(0, 1fr); }
    .card--wide { grid-column: span 6; grid-template-columns: var(--thumb) minmax(0, 1fr); }
    .grid { --thumb: clamp(140px, 14.4vw, 208px); }
    .grid:not([data-filter="all"]) .card { grid-column: span 4; grid-row: auto; grid-template-columns: minmax(0, 1fr); }
  }
</style>
